# ---- Contracts deployment (packages/contracts) ----
# RPC endpoint for Linea Sepolia (testnet). Public default shown; swap for a
# dedicated key (Infura/Alchemy/Linea) for anything beyond light testing.
LINEA_SEPOLIA_RPC_URL=https://rpc.sepolia.linea.build
LINEA_MAINNET_RPC_URL=https://rpc.linea.build

# Private key used ONLY to deploy contracts. The deployer becomes the registry
# admin (who seats jurors) and is auto-seated as the first juror so a fresh
# deployment is usable. Seat at least three independent jurors before trusting
# any verdict — quorum is 3 weight and a one-juror jury is exactly the
# centralization the jury design removes.
# Never fund this with real assets. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Block explorer API key for contract verification (Lineascan / Etherscan v2 API)
LINEASCAN_API_KEY=

# ---- Gasless relayer (apps/mobile) ----
# If unset, the app falls back to the mock relayer and all "gasless tx" calls
# are simulated locally — no network call is made. See README "Gasless relayer"
# section for what a real setup needs.
EXPO_PUBLIC_GASLESS_PROVIDER=mock
# EXPO_PUBLIC_GASLESS_PROVIDER=pimlico
EXPO_PUBLIC_PIMLICO_API_KEY=
EXPO_PUBLIC_PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/linea-sepolia/rpc
EXPO_PUBLIC_PIMLICO_PAYMASTER_URL=https://api.pimlico.io/v2/linea-sepolia/rpc

# Deployed ReportRegistry address on Linea Sepolia (fill in after
# `npm run contracts:deploy:sepolia`)
EXPO_PUBLIC_REPORT_REGISTRY_ADDRESS=

# ---- Content layer (apps/mobile) ----
# Where encrypted report bundles and evidence blobs live. If unset, the app uses
# a local mock store — content-addressed the same way, but never leaves the
# device, so the feed works end-to-end with no credentials.
EXPO_PUBLIC_CONTENT_STORE=mock
# EXPO_PUBLIC_CONTENT_STORE=ipfs
# Pinning endpoint + token (web3.storage, Pinata, Filebase, …)
EXPO_PUBLIC_IPFS_API_URL=https://api.web3.storage/upload
EXPO_PUBLIC_IPFS_API_TOKEN=
# Public read gateway
EXPO_PUBLIC_IPFS_GATEWAY_URL=https://w3s.link/ipfs

# ---- Feed indexer (apps/mobile) — OPTIONAL ----
# Points the feed at a real indexer (Ponder, subgraph, SubQuery) instead of
# scanning eth_getLogs. Reading logs directly works and does not scale — every
# page view rescans the corpus. See src/feed/indexerNetworkIndex.ts for the
# endpoint contract. The indexer is untrusted for correctness: every row it
# returns is still hash-checked against the chain anchor on read.
EXPO_PUBLIC_INDEXER_URL=

# ---- Anonymising transport (apps/mobile) ----
# All egress goes through src/net/transport.ts, and the strongest available
# transport wins:
#
#   1. Embedded Tor (modules/expo-tor) — real onion routing, in-process Arti.
#      Needs no configuration here: it is compiled into development and release
#      builds and started by the user in Settings → Network. Not available in
#      Expo Go or the web preview, which cannot load native code.
#
#   2. HTTP proxy fronting Tor — set the variable below. An Orbot HTTP port, or
#      a self-hosted privoxy→tor pair. Weaker than onion routing (the proxy
#      operator sees every destination) and better than direct. The app marks
#      this "claimed but not verified" because it cannot confirm the proxy
#      actually reaches Tor.
#
#   3. Direct — your IP is visible to the relayer, the content gateway, and the
#      RPC endpoint. What you get if neither of the above is active.
#
# Settings → Network shows the live state and offers a fail-closed switch that
# refuses to send rather than leak.
EXPO_PUBLIC_ANONYMISING_PROXY_URL=

# ---- WalletConnect (apps/mobile) — OPTIONAL ----
# Only needed if you want to offer the external-wallet identity option. Leaving
# this unset is the safer default: the anonymous device key is the primary path
# and works with no configuration. See README "Identity" for the anonymity
# trade-off users are warned about before connecting.
# Get a project id from https://dashboard.reown.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Zero-knowledge personhood (Semaphore) — OPTIONAL ----
# Address of the canonical Semaphore deployment on the target chain. Use the
# published one rather than deploying your own: the verifier embeds a
# trusted-setup verification key, and the deployment everyone else audits is
# worth more than a fresh one nobody has looked at.
#   https://docs.semaphore.pse.dev/deployed-contracts
SEMAPHORE_ADDRESS=

# Deployed SemaphorePersonhoodGate. Point ReportRegistry at this with
# setPersonhoodGate() to make corroboration sybil-resistant WITHOUT the
# operator learning who corroborated.
#
# Leaving it unset means corroboration is open to any address, which is
# honest for a testnet and not sybil-resistant at all.
EXPO_PUBLIC_PERSONHOOD_GATE_ADDRESS=
