# ---- Contracts deployment (packages/contracts) ----
# RPC endpoint for Linea Sepolia (testnet). Public default shown; swap for a
# dedicated key (Infura/Alchemy/Linea) for anything beyond light testing.
LINEA_SEPOLIA_RPC_URL=https://rpc.sepolia.linea.build
LINEA_MAINNET_RPC_URL=https://rpc.linea.build

# Private key used ONLY to deploy contracts / act as the moderator address
# on testnet. Never fund this with real assets. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Block explorer API key for contract verification (Lineascan / Etherscan v2 API)
LINEASCAN_API_KEY=

# ---- Gasless relayer (apps/mobile) ----
# If unset, the app falls back to the mock relayer and all "gasless tx" calls
# are simulated locally — no network call is made. See README "Gasless relayer"
# section for what a real setup needs.
EXPO_PUBLIC_GASLESS_PROVIDER=mock
# EXPO_PUBLIC_GASLESS_PROVIDER=pimlico
EXPO_PUBLIC_PIMLICO_API_KEY=
EXPO_PUBLIC_PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/linea-sepolia/rpc
EXPO_PUBLIC_PIMLICO_PAYMASTER_URL=https://api.pimlico.io/v2/linea-sepolia/rpc

# Deployed ReportRegistry address on Linea Sepolia (fill in after
# `npm run contracts:deploy:sepolia`)
EXPO_PUBLIC_REPORT_REGISTRY_ADDRESS=
