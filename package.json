{
  "name": "khabardar",
  "private": true,
  "version": "0.1.0",
  "description": "Anonymous anti-corruption reporting app — monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "contracts:compile": "npm run compile --workspace packages/contracts",
    "contracts:test": "npm run test --workspace packages/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia --workspace packages/contracts",
    "mobile:start": "npm run start --workspace apps/mobile",
    "mobile:web": "npm run web --workspace apps/mobile",
    "mobile:typecheck": "npm run typecheck --workspace apps/mobile",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
